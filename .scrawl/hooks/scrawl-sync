#!/bin/sh
# Scrawl: bring local main up to date with GitHub, so merged PRs show up as Shipped on the board.
# Claude runs this at the start of /resolve and /next; it is safe to run any time.
#
# Uncommitted changes under .scrawl/ are the live board (card moves, comments). They are kept,
# and they win over any older snapshot of the same files that a merged PR brought in.
cd "$(git rev-parse --show-toplevel)" || exit 1
remote=origin

main=
for b in main master; do
  if git rev-parse --verify -q "refs/heads/$b" >/dev/null; then main=$b; break; fi
done
[ -n "$main" ] || exit 0

done_() { sh .scrawl/hooks/scrawl-main; exit 0; }

git remote get-url "$remote" >/dev/null 2>&1 || done_
if ! git fetch -q --prune "$remote"; then
  echo "scrawl-sync: couldn't reach $remote; the board may be behind GitHub" >&2
  done_
fi

target="$remote/$main"
[ "$(git rev-parse "$main")" = "$(git rev-parse "$target")" ] && done_

if ! git merge-base --is-ancestor "$main" "$target"; then
  echo "scrawl-sync: local $main has commits that $target doesn't; left it alone" >&2
  done_
fi

if [ "$(git symbolic-ref -q --short HEAD)" != "$main" ]; then
  # Another branch is checked out: just move the main ref forward.
  git fetch -q "$remote" "$main:$main"
  done_
fi

# On main: fast-forward with the live board edits parked and laid back on top.
. .scrawl/hooks/scrawl-board
with_board scrawl-sync git merge -q --ff-only "$target" ||
  echo "scrawl-sync: couldn't fast-forward $main; the board may be behind GitHub" >&2
done_
