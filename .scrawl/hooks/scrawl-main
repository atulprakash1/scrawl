#!/bin/sh
# Scrawl: list the commits on the main branch so the board can mark finished items as Shipped.
# Called by post-commit, post-merge and scrawl-sync. Writes "shortsha|subject", newest first,
# to .scrawl/log/main.txt. Subjects matter: squash and rebase merges give the work new shas.
out=.scrawl/log/main.txt

[ -d .scrawl/log ] || exit 0

main=
for b in main master; do
  if git rev-parse --verify -q "refs/heads/$b" >/dev/null; then main=$b; break; fi
done
[ -n "$main" ] || exit 0

git log --format='%h|%s' --max-count=2000 "$main" > "$out.tmp" && mv -f "$out.tmp" "$out"
